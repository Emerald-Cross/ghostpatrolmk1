# Set a long private passphrase before using on the office network.
REFEREE_SECRET=replace-with-a-private-passphrase-at-least-16-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-another-random-secret-at-least-32-characters
# For shared cloud state: run supabase/schema.sql, then configure BOTH values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Memory mode is only allowed outside Vercel. It resets when the server stops.
LOCAL_DEMO=1
PORT=3000
